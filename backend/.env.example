# Salin file ini menjadi .env lalu isi nilainya.
#
# JWT_SECRET WAJIB diisi (minimal 16 karakter). Server akan menolak start bila kosong.
# Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here

PORT=5000

# Kredensial akun guru yang dibuat otomatis saat pertama kali server dijalankan.
# Bila akun sudah ada, nilainya akan disinkronkan (dipakai juga untuk mengganti
# password bawaan lama 'admin123').
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
